# Copy to .env.local to override. Never commit .env.local.

# Where "Try now" sends people: the Ambrace app. Read at build time, so set it
# per environment on Vercel (Production: https://app.ambrace.in).
# Leave it unset to use the dev app, https://app-dev.ambrace.in.
NEXT_PUBLIC_APP_URL=https://app-dev.ambrace.in
